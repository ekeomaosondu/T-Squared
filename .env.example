# ---------------------------------------------------------------------------
# Kalshi credentials
# ---------------------------------------------------------------------------
# production -> https://api.elections.kalshi.com
# demo       -> https://demo-api.kalshi.co
KALSHI_ENV=production

KALSHI_API_KEY_ID=

# RSA private key in PKCS#8 PEM form.
#
# Vercel environment variables are single-line, so the PEM must be encoded.
# Two forms are accepted by src/kalshi/auth.ts, in this order:
#
#   1. base64 of the whole PEM file (recommended for Vercel):
#        cat kalshi.pem | base64 | pbcopy
#   2. the literal PEM with newlines replaced by the two characters \n :
#        awk 'BEGIN{ORS="\\n"} {print}' kalshi.pem | pbcopy
#
# A real multi-line PEM also works when set via a .env file or a shell heredoc.
KALSHI_PRIVATE_KEY_PEM=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Local dev (docker compose up -d):
DATABASE_URL=postgres://kalshi:kalshi@localhost:54329/kalshi_recorder

# Direct (non-pooled) connection, used for migrations, partition maintenance and
# DETACH PARTITION CONCURRENTLY. Neon's pooler is a TRANSACTION pooler, so
# session-level behaviour and some DDL do not survive it. Leave empty for a
# plain single-endpoint Postgres; it then falls back to DATABASE_URL.
#
# Production (Neon):
#   DATABASE_URL=postgres://...@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
#   DIRECT_DATABASE_URL=postgres://...@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# Dataset identity
# ---------------------------------------------------------------------------
# Stamped on every collector session, archive manifest, integrity report,
# export and materialized dataset.
DATASET_ID=kalshi-dev
DEPLOYMENT_ENV=development

# ---------------------------------------------------------------------------
# Archive storage
# ---------------------------------------------------------------------------
# r2 | s3 | vercel_blob | local
#
# Cloudflare R2 is the intended target for the research lake: it charges no
# egress, which matters when the workflow is repeatedly scanning Parquet from a
# workstation with DuckDB, and its S3 API lets DuckDB read directly from it.
ARCHIVE_STORAGE=local

ARCHIVE_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com
ARCHIVE_ENDPOINT=
ARCHIVE_ACCESS_KEY_ID=
ARCHIVE_SECRET_ACCESS_KEY=
ARCHIVE_REGION=auto

# Only for ARCHIVE_STORAGE=vercel_blob. Objects are written PRIVATE: this is a
# proprietary dataset and a public archive would expose the whole order-book
# history to anyone with the URL.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Collector lifecycle
# ---------------------------------------------------------------------------
COLLECTOR_ENABLED=true

# vercel_rolling -> short-lived sessions coordinated by a Postgres lease
# daemon         -> one long-lived process (npm run collector)
COLLECTOR_MODE=daemon

# Soft handoff request, then forced shutdown. Both must sit below the platform
# hard limit (Vercel Fluid Compute maxDuration).
COLLECTOR_SOFT_RUNTIME_SECONDS=1440
COLLECTOR_HARD_RUNTIME_SECONDS=1680

# A collector whose heartbeat is older than this is considered dead and may be
# taken over by a standby.
COLLECTOR_HEARTBEAT_INTERVAL_MS=5000
COLLECTOR_HEARTBEAT_STALE_MS=20000

# ---------------------------------------------------------------------------
# Discovery / metadata
# ---------------------------------------------------------------------------
MARKET_DISCOVERY_INTERVAL_MS=60000
METADATA_REFRESH_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Integrity
# ---------------------------------------------------------------------------
REST_BOOK_VALIDATION_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Retention / archive
# ---------------------------------------------------------------------------
# Master switch for DESTRUCTIVE partition removal.
#
# MUST remain false until archival exists and has verified a partition's row
# count and SHA-256 against object storage. Until then there is nowhere for
# dropped raw data to go, so enabling this only destroys it.
#
# Enable only after:
#   partition -> archive -> row count verified -> SHA-256 verified
#   -> marked VERIFIED -> retention floor elapsed -> detach -> drop
RAW_DB_RETENTION_ENABLED=false

# Minimum age of a COMPLETED daily partition before it becomes eligible for
# removal. This is a floor, not an exact TTL: with daily UTC partitions the
# effective retention is between RAW_DB_RETENTION_HOURS and that plus 24h.
# A partition is never dropped unless its archive is verified.
RAW_DB_RETENTION_HOURS=48
RAW_ARCHIVE_ENABLED=true

# Create daily partitions this far ahead. Surfaced as the partitions_ahead
# health metric: >=3 healthy, 2 warning, 1 critical, 0 collector at risk.
RAW_PARTITION_AHEAD_DAYS=7
RAW_PARTITION_MAINTENANCE_INTERVAL_MS=3600000

# How often completed partitions are sealed, uploaded and verified.
ARCHIVE_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Database write batching
# ---------------------------------------------------------------------------
DB_BATCH_MAX_ROWS=500
DB_BATCH_MAX_WAIT_MS=250
# Hard in-memory ceiling for buffered rows while the DB is unavailable.
DB_BUFFER_MAX_ROWS=200000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Pretty-print logs locally. Never enable in production.
LOG_PRETTY=false

# Shared secret for the internal read APIs and the /api/collector/run cron
# route. Vercel Cron requests are also accepted via CRON_SECRET.
INTERNAL_API_TOKEN=
CRON_SECRET=

# Path to the collector config file (see config/collector.example.json).
COLLECTOR_CONFIG_PATH=config/collector.json
