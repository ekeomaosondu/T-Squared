# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kalshi market-data recorder
# .env* above ignores real credentials; the template is committed.
!.env.example
# Emergency write-buffer spool; contains captured market data.
.spool/
# Active local config. The *.example.json files are committed instead.
config/collector.json
# Export CLI output.
/exports/
# Materialized research datasets (regenerable from the delta stream).
/research/
# Local archive backend output (dev only).
/.archive/
