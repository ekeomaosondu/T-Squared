{
  "$comment": "Illustrates capturing the FULL weather prefix scope. This is ~104 series: a much larger database, more subscriptions and more opportunity for gaps. maxCaptureSeries must be raised deliberately to allow it.",
  "discoveryScope": {
    "$comment": "Observed for metadata only, never subscribed. Keeps visibility into what could be captured. On the live exchange these prefixes match 104 Climate and Weather series; without the category filter they also match KXHIGHINFLATION, KXLOWESTRATE and KXHIGHMOVDJT.",
    "seriesPrefixes": [
      "KXHIGH",
      "KXLOW"
    ],
    "categories": [
      "Climate and Weather"
    ],
    "persistMetadata": true
  },
  "maxCaptureSeries": 150,
  "selectors": [
    {
      "id": "all-weather-temperature",
      "seriesPrefixes": [
        "KXHIGH",
        "KXLOW"
      ],
      "categories": [
        "Climate and Weather"
      ],
      "statuses": [
        "initialized",
        "active",
        "inactive",
        "closed",
        "determined"
      ],
      "subscribeBeforeOpenSeconds": 21600,
      "retainAfterCloseSeconds": 7200
    }
  ],
  "capture": {
    "orderbookDeltas": true,
    "trades": true,
    "tickerUpdates": true,
    "lifecycleEvents": true,
    "privateOrders": false,
    "privateFills": false
  },
  "sampling": {
    "bboIntervalsMs": [
      1000,
      5000,
      60000
    ],
    "fullBookIntervalsMs": [
      5000,
      60000
    ],
    "eventLadderIntervalsMs": [
      1000,
      5000,
      60000
    ]
  },
  "validation": {
    "restOrderbookIntervalMs": 60000,
    "maxMarketsPerValidationBatch": 100,
    "matchToleranceMs": 2000
  },
  "retention": {
    "rawPostgresHours": 48,
    "normalizedDays": null
  }
}
