{
  "$comment": "Narrow config used for local end-to-end smoke runs. Two NY series only, fast sampling, so a 60s run exercises every code path.",
  "selectors": [
    {
      "id": "smoke-ny-temperature",
      "seriesAllowlist": [
        "KXHIGHNY",
        "KXLOWNY"
      ],
      "statuses": [
        "initialized",
        "active",
        "inactive",
        "closed",
        "determined"
      ],
      "subscribeBeforeOpenSeconds": 21600,
      "retainAfterCloseSeconds": 7200
    }
  ],
  "capture": {
    "orderbookDeltas": true,
    "trades": true,
    "tickerUpdates": true,
    "lifecycleEvents": true,
    "privateOrders": false,
    "privateFills": false
  },
  "sampling": {
    "bboIntervalsMs": [
      1000,
      5000
    ],
    "fullBookIntervalsMs": [
      5000
    ],
    "eventLadderIntervalsMs": [
      1000,
      5000
    ]
  },
  "validation": {
    "restOrderbookIntervalMs": 20000,
    "maxMarketsPerValidationBatch": 100
  },
  "retention": {
    "rawPostgresHours": 48,
    "normalizedDays": null
  },
  "maxCaptureSeries": 25
}
