{
  "name": "kalshi-market-recorder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "collector": "tsx scripts/collector.ts",
    "replay": "tsx scripts/replay.ts",
    "export": "tsx scripts/export.ts",
    "loadtest": "tsx scripts/loadTest.ts",
    "archive": "tsx scripts/archive.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run migrate",
    "db:psql": "docker compose exec -T postgres psql -U kalshi -d kalshi_recorder",
    "verify-replay": "tsx scripts/verifyReplay.ts",
    "soak": "tsx scripts/soak.ts",
    "soak:verify": "tsx scripts/soakVerify.ts",
    "restore": "tsx scripts/restore.ts",
    "integrity": "tsx scripts/integrityCheck.ts",
    "integrity:full": "tsx scripts/integrityCheck.ts --full",
    "materialize": "tsx scripts/materialize.ts",
    "silver": "tsx scripts/silver.ts",
    "archive:smoke": "tsx scripts/archiveSmoke.ts",
    "cutover": "tsx scripts/cutover.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@duckdb/node-api": "^1.5.5-r.5",
    "@vercel/blob": "^2.8.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "js-yaml": "^5.4.2",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "description": "Production-grade Kalshi market-data recorder for KXHIGH/KXLOW"
}